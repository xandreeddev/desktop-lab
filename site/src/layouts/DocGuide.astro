---
import { withBase } from '../data/urls';
import Base from './Base.astro';
import DocsNav from '../components/DocsNav.astro';
interface Props {
  title: string;
  description: string;
  chapter: string;
  heading: string;
  accent: string;
  sections: [string, string][];
  audience?: string;
}
const { title, description, chapter, heading, accent, sections, audience = 'Developer guide' } = Astro.props;
---
<Base title={`${title} — Lucent documentation`} description={description}>
  <section class="guide-intro wrap">
    <a class="text-link" href={withBase('/docs/')}>← Documentation overview</a>
    <span class="eyebrow">{audience} / {chapter.toUpperCase()}</span>
    <h1>{heading}<br /><span class="mint-text">{accent}</span></h1>
    <p>{description}</p>
  </section>
  <div class="guide-layout wrap">
    <aside class="guide-nav">
      <span class="eyebrow">DOCUMENTATION</span>
      <DocsNav current={chapter} />
      <nav aria-label="On this page">{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
    </aside>
    <div class="guide-content"><slot /></div>
  </div>
</Base>
