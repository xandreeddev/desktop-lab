---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { Image } from 'astro:assets';
import lucid from '../../../reports/screenshots/lucid-launcher.png';
import noctalia from '../../../reports/screenshots/noctalia.png';
import lucent from '../../../reports/screenshots/lucent-framework-desktop.png';
import metrics from '../../../reports/measurements/lucent-framework-performance.json';
import { layers, componentCode } from '../data/framework';
import { tokens } from '../data/tokens';
const repo = 'https://github.com/xandreeddev/desktop-lab/blob/main/';
const desktops = [
  { name: 'Lucid', number: '01', label: 'THE REFERENCE', tech: 'Quickshell · Qt / QML', image: lucid, description: 'The original experience: floating capsules, Bookends widgets and the dock that becomes a launcher. Installed at a pinned revision, integrated into Omarchy.', ownership: 'Upstream shell. Our configuration and integration.', link: 'https://github.com/Sn3akyy1/lucid' },
  { name: 'Noctalia', number: '02', label: 'THE COMPARISON', tech: 'Noctalia v5 · Native C++', image: noctalia, description: 'A native shell configured toward the same visual language. Rounded islands, a centered dock and desktop widgets, using its supported TOML configuration.', ownership: 'Upstream shell. Our Lucid-inspired configuration.', link: 'https://docs.noctalia.dev/noctalia/' },
  { name: 'Lucent', number: '03', label: 'THE FRAMEWORK', tech: 'Rust · Wayland · Vulkan', image: lucent, description: 'Our independent framework and desktop client. Declarative components, real system integration, native surfaces and a shared renderer, shaped by the Lucid reference.', ownership: 'Our framework, renderer and desktop client.', link: '#framework' },
];
---
<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-eyebrow"><span class="eyebrow">DESKTOP LAB / EXPERIMENT 003</span><span class="pill"><span class="status-dot"></span>Running in the lab</span></div>
    <div class="hero-intro"><h1 id="hero-title">A desktop,<br />from the <span>inside out.</span></h1><div class="hero-copy"><p>Meet <strong>Lucent</strong>. A native Rust framework and a desktop built on it. Inspired by Lucid. At home on Omarchy.</p><a class="button primary" href="#desktop">Explore the desktop <span aria-hidden="true">↓</span></a><a class="text-link" href="#framework">Go beneath the surface ↗</a></div></div>
    <div class="hero-meta"><span>RUST AT THE CORE</span><span>WAYLAND AT THE EDGES</span><span>VULKAN FOR EVERY PIXEL</span><span>BUILT BY XAND REED</span></div>
  </section>

  <section id="desktop" class="wrap desktop-tour" aria-label="Lucent desktop tour"><Gallery /></section>

  <section id="desktops" class="section wrap">
    <div class="section-heading"><div><span class="eyebrow">01 / THE EXPERIMENT</span><h2>Three paths.<br />One familiar desktop.</h2></div><p>Same Omarchy foundation. Separate virtual machines. Each experiment asks a different question about how much of the desktop we should build ourselves.</p></div>
    <div class="experiment-grid">{desktops.map((desktop) => <article class:list={['experiment', { featured: desktop.name === 'Lucent' }]}><div class="experiment-top"><span>{desktop.number}</span><span>{desktop.label}</span></div><Image src={desktop.image} alt={`${desktop.name} running in its isolated Omarchy VM`} widths={[480, 800]} sizes="(max-width: 760px) 94vw, 30vw" format="webp" loading="lazy" /><div class="experiment-body"><h3>{desktop.name}<a href={desktop.link} aria-label={`Explore ${desktop.name}`}>↗</a></h3><span class="mono small">{desktop.tech}</span><p>{desktop.description}</p><div class="ownership-note">{desktop.ownership}</div></div></article>)}</div>
    <p class="section-footnote">Each VM has its own configuration and rollback path. The screenshots capture different test sessions; they are not a controlled performance comparison.</p>
  </section>

  <section class="ownership-section">
    <div class="wrap ownership-layout"><div><span class="eyebrow">THE IMPORTANT BOUNDARY</span><h2>New shell.<br />Familiar foundations.</h2><p>Lucent is the bar, dock, launcher, selectors and widgets you see. Hyprland still arranges your application windows. Omarchy still handles the session around them.</p><a class="text-link" href="/guide/#ownership">Who owns what? ↗</a></div><div class="ownership-stack"><div><span class="stack-marker mint"></span><span><strong>Lucent</strong><small>Bar · dock · launcher · widgets · selectors</small></span><span class="stack-label">OUR RUST CODE</span></div><div><span class="stack-marker blue"></span><span><strong>Hyprland</strong><small>Windows · tiling · workspaces · input</small></span><span class="stack-label">COMPOSITOR</span></div><div><span class="stack-marker peach"></span><span><strong>Omarchy + Arch</strong><small>Lock · notifications · background · session</small></span><span class="stack-label">FOUNDATION</span></div></div></div>
  </section>

  <section id="framework" class="section wrap">
    <div class="section-heading"><div><span class="eyebrow">02 / UNDER THE SURFACE</span><h2>A framework with<br />clear boundaries.</h2></div><p>Seven implemented crates. Two independent clients. The desktop is one expression of the framework; its colors, calendar and launcher stay in the client.</p></div>
    <div class="architecture" data-tabs>
      <div class="architecture-tabs" role="tablist" aria-label="Framework architecture layers" aria-orientation="vertical">{layers.map((layer, i) => <button id={`layer-${layer.id}`} type="button" role="tab" aria-selected={i === 0} aria-controls={`detail-${layer.id}`} tabindex={i === 0 ? 0 : -1}><span class="layer-number">{layer.number}</span><span><strong>{layer.title}</strong><small>{layer.subtitle}</small></span><span aria-hidden="true">↗</span></button>)}</div>
      <div class="architecture-details">{layers.map((layer, i) => <div id={`detail-${layer.id}`} role="tabpanel" aria-labelledby={`layer-${layer.id}`} hidden={i !== 0} tabindex="0"><span class="code-tag">{layer.tag}</span><h3>{layer.heading}</h3><p>{layer.text}</p><div class="concepts">{layer.concepts.map(concept => <span>{concept}</span>)}</div><div class="flow-line">{layer.flow}</div><a href={`${repo}${layer.source}`} class="text-link">Read the implementation ↗</a></div>)}</div>
    </div>
    <div class="api-section"><div class="api-copy"><span class="eyebrow">THE CLIENT CONTRACT</span><h3>Describe the view.<br />Handle the message.</h3><p>A component owns its state. <code>view</code> describes elements. <code>update</code> handles a typed message and requests effects. The runtime takes care of input, work and redraws.</p><dl class="concept-list"><div><dt>Compose</dt><dd>Map a child’s messages into the parent. Delegate its effects without losing redraws or results.</dd></div><div><dt>Subscribe</dt><dd>Give a stream a stable identity. The runtime starts it once and cancels it when it leaves.</dd></div><div><dt>Extend</dt><dd>Register a widget by ID. Another desktop can use the same API with entirely different domain models.</dd></div></dl><a class="text-link" href={`${repo}docs/lucent-framework.md`}>Read the framework guide ↗</a></div><CodeBlock code={componentCode} lang="rust" label="A complete Component implementation" /></div>
  </section>

  <section class="motion-section section">
    <div class="wrap motion-layout"><div><span class="eyebrow">03 / THE FEEL OF IT</span><h2>Motion with<br />a destination.</h2><p>The dock expands into a launcher. The selector brings the next wallpaper forward. Interrupted transitions continue from their current position.</p><p>Lucent uses the spatial curve inspected in the pinned Lucid reference. Frames follow compositor callbacks, and stop when the transition ends.</p><div class="motion-values"><div><strong>500<span> ms</span></strong><small>Dock & selector</small></div><div><strong>350<span> ms</span></strong><small>App selection</small></div><div><strong>0</strong><small>Idle dock frames / 120 s</small></div></div></div>
      <div class="motion-demo" data-motion-demo><div class="demo-label"><span>INTERACTIVE MOTION STUDY</span><span>Browser illustration</span></div><div class="motion-stage"><div class="motion-orbit" aria-hidden="true"></div><div class="demo-shell" id="motion-panel"><div class="demo-expanded" inert><div class="demo-mini-tabs"><span>Apps</span><span>Widgets</span><span>Palette</span></div><div class="demo-app selected"><span class="demo-icon">›_</span><span>Terminal</span><small>↵</small></div><div class="demo-app"><span class="demo-icon">◉</span><span>Browser</span></div><div class="demo-search">⌕ <span>Search your applications</span></div></div><div class="demo-dock" aria-hidden="true"><span>⠿</span><span>›_</span><span>◉</span><span>▤</span><span>✳</span></div></div></div><div class="demo-controls"><button class="button secondary" type="button" data-motion-toggle aria-expanded="false" aria-controls="motion-panel">Expand launcher <span aria-hidden="true">↗</span></button><code>cubic-bezier(.38, 1.21, .22, 1)</code></div><p class="demo-note">Illustrates the curve and geometry in CSS. The desktop above renders natively through Vulkan.</p></div>
    </div>
  </section>

  <section class="section wrap surfaces-section">
    <div class="section-heading"><div><span class="eyebrow">04 / A PLACE FOR EVERYTHING</span><h2>Layers for the shell.<br />Tiles for your apps.</h2></div><p>A widget is a native Wayland surface region. It stays out of the tiling layout, so moving a clock never rearranges your terminal.</p></div>
    <div class="surface-grid"><article><span class="surface-number">01</span><div class="surface-sketch bar-sketch" aria-hidden="true"><i></i><i></i><i></i></div><h3>Top bar</h3><p>Floating capsules reserve 56 logical pixels. Workspace pills switch real Hyprland workspaces.</p><span class="code-tag">Layer::Top</span></article><article><span class="surface-number">02</span><div class="surface-sketch widget-sketch" aria-hidden="true"><i>12<br />45</i><i>◷</i></div><h3>Widget host</h3><p>Seven registered widgets. Drag backgrounds to move them; release to save. They sit below application windows.</p><span class="code-tag">Layer::Bottom</span></article><article><span class="surface-number">03</span><div class="surface-sketch dock-sketch" aria-hidden="true"><i>⠿ &nbsp; ›_ &nbsp; ◉ &nbsp; ▤</i></div><h3>Dock & overlays</h3><p>The launcher claims keyboard input while open. Escape or an outside click closes it. Transparent areas otherwise pass clicks through.</p><span class="code-tag">Top → Overlay</span></article></div>
  </section>

  <section id="measurements" class="section wrap measurements">
    <div class="section-heading"><div><span class="eyebrow">05 / FIELD NOTES</span><h2>Measured.<br />With the context attached.</h2></div><p>Omarchy 4.0.4 · Hyprland 0.56.2<br />2 vCPUs · 3 GiB RAM · 1920 × 1080<br /><strong>Software Vulkan, Mesa lavapipe.</strong></p></div>
    <div class="metric-grid"><div><span class="metric-value">{metrics.idle.cpu_percent_one_core.toFixed(2)}<small>%</small></span><h3>Idle process CPU</h3><p>One logical core, over 120 seconds.</p></div><div><span class="metric-value">{metrics.idle.rss_mib_mean.toFixed(0)}<small>MiB</small></span><h3>Mean process memory</h3><p>{metrics.idle.rss_mib_max.toFixed(2)} MiB peak RSS in the sample.</p></div><div><span class="metric-value">~30<small>fps</small></span><h3>Launcher transitions</h3><p>33.20–34.36 ms median frame intervals.</p></div></div>
    <div class="measurement-detail"><p><strong>The GPU matters.</strong> This VM uses CPU-backed Vulkan. The initial 60 fps and under-200 MiB goals are still unmet here. Hardware GPU performance remains unmeasured.</p><p>The full Lucent service, including helper commands, used {metrics.idle.service_cpu_percent_one_core}% of one core at idle. These figures exclude retained Omarchy services and the compositor. GPU memory is not measured independently. Frame intervals are render submissions, not scanout.</p></div>
    <div class="validation-grid"><div><span class="eyebrow mint-text">EXECUTED & VERIFIED</span><h3>Real input. Real outcomes.</h3><ul class="check-list"><li>23 Rust tests and 11 configuration / token / rollback tests</li><li>Keyboard search and a real terminal launch</li><li>Widget drag, save, restart and restored position</li><li>Wallpaper application and audio mute / unmute</li><li>Secure lock, reboot, rollback and reactivation</li><li>Independent hello-layer client and click-through</li></ul></div><div><span class="eyebrow peach-text">STILL AHEAD</span><h3>The honest boundary.</h3><p>Full Lucid parity is a destination. Notification history, tray hosting, clipboard and emoji modes, a full control center, palette extraction and widget resizing are still ahead.</p><p>Fractional scaling, multiple outputs and full Unicode shaping remain unimplemented. Physical Wi-Fi, Bluetooth, battery, brightness, hotplug, suspend/resume and real media playback were not validated in this VM run.</p></div></div>
    <div class="report-links"><a class="text-link" href={`${repo}reports/lucent-framework.md`}>Read the validation report ↗</a><a class="text-link" href="/reports/performance.json" download>Download measured data ↓</a></div>
  </section>

  <section class="design-invitation wrap"><div><span class="eyebrow">THE DESIGN SYSTEM</span><h2>A language for<br />every little detail.</h2><p>Explore the colors, type, spacing and motion behind Lucent. Shared tokens connect the native desktop to a living reference you can build from.</p><a class="button primary" href="/design-system/">Explore the system ↗</a> <a class="text-link" href="/docs/">Read the docs ↗</a></div><div class="token-chain"><div><small>PRIMITIVE</small><code>palette.cyan_300</code><span>{String(tokens.find(t => t.name === "palette.cyan_300")?.value)}</span></div><div><small>SEMANTIC</small><code>theme.dark.primary</code><span>Intent, shared across components</span></div><div><small>COMPONENT</small><code>theme.button(…)</code><span>The same language, made tangible</span></div></div></section>
  <section class="try-section wrap"><div><span class="eyebrow">YOUR TURN</span><h2>Open the lab.<br />Make it your desktop.</h2><p>Start with one isolated VM. Try the launcher, move a widget, explore the framework, and switch back whenever you need.</p><a class="button primary" href="/guide/">Open the testing guide <span aria-hidden="true">↗</span></a></div><div class="try-terminal"><span class="eyebrow">ON THE PREPARED LAB HOST</span><CodeBlock code="python3 vm/launch.py lucent" label="Start the Lucent VM" /><div class="shortcut-row"><kbd>Super</kbd><span>+</span><kbd>Space</kbd><span>And you’re in.</span></div><p>Already have Omarchy? The guide also covers building, installing, and rolling back.</p></div></section>
</Base>
