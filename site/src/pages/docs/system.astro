const sections: [string, string][] = [['startup','01 · Startup and handoff'],['ownership','02 · Responsibility map'],['rendering','03 · Rendering boundaries'],['menus','04 · Menu and binding routes'],['verify','05 · Inspect your installation']];
const ownership = [
