const sections: [string, string][] = [['verdict','01 · Assessment'],['concepts','02 · Domain concepts'],['ports','03 · Ports and adapters'],['findings','04 · Findings and changes'],['performance','05 · Performance evidence'],['gaps','06 · Feature gaps'],['next','07 · Next architectural steps']];
const ports = [
  ['ApplicationPort', 'Discover, launch and explicitly open targets', 'XdgApplications', 'Merged catalog/actions, fresh launch context and Open. XDG/D-Bus/argv IO stays in this adapter; domain values carry no Wayland handles. Scoped real Chromium intent acceptance passes nine feature and eight restoration checks on unchanged 8e with the d1 independent consumer, now merged through PR89; other applications and direct token consumption remain unverified'],
  ['CompositorPort', 'Read windows/workspaces, focus, switch and watch', 'Hyprland', 'Hyprland request/event sockets; reconnect policy in adapter'],
  ['SettingsPort', 'Load and save DesktopSettings', 'JsonSettings', 'Validated JSON and atomic replacement'],
  ['ClockPort', 'Supply local date and time', 'LocalClock', 'System time through chrono'],
  ['SystemPort', 'Sample CPU and memory state', 'LinuxSystem', 'Linux counters; separate audio and network ports'],
  ['AudioPort', 'Observe devices/streams and issue controls', 'PulseAudio', 'Native libpulse connection, bounded command queue, reconnect; native panel, virtual playback/capture routing, command timeout, hotplug and reconnect verified; hardware validation remains open'],
  ['NetworkPort', 'Observe network state and request operations', 'NetworkManager', 'Native system-bus adapter with bounded commands/events, temporary handles and signal-driven state. The root injects it into a native child with masked SecretAgent repair that retains the saved profile UUID and storage policy. Fourteen owned-radio native recovery checks pass; physical Wi-Fi, enterprise provisioning and agent-owned vaults remain open'],
  ['BluetoothPort', 'Observe controllers/devices and control discovery or paired devices', 'BlueZ', 'Native system-bus owner with transient handles, bounded commands and connection-scoped discovery. Native input, virtual-controller radio controls, discovery, explicit pairing/bonding, trust/removal and confirmed Forget pass. The rebuilt signal fix observes external changes without a restart. Decline/Escape cancellation and unpaired Disconnect reach observed terminal phases while the reference peer stays alive. Legacy entrypoints now open the native child. Connect has an explicit attempt ID and urgent cancellation; private protocol/client checks cover pending authorization, late admission, retirement and timeout. Native pending-profile, incoming and physical validation remain pending'],
  ['DisplayPort', 'Read/watch layouts and apply, keep or revert a draft', 'HyprlandDisplays', 'Ordered complete captures and an independent same-executable guardian; verified native preview, 15-second deadline and UI-pipe EOF rollback; atomic guarded user monitors.lua persistence. Seven earlier one-output flows and the historical four-flow two-output result retain their scope. Later harness 1774fa87 on runtime 26d03adf passes nine virtual-output flows, including rotation, disable/re-enable and native input on a fractional Displays panel; physical/cable hotplug, suspend, compositor restart, secure-output and pacing acceptance remain separate'],
  ['PowerPort', 'Observe battery/profiles/backlights and request power operations', 'PowerServices', 'Native UPower, profile, sysfs and logind adapters; command admission is separate from observed completion. SDK controls and owned protocol fixtures exist; VM/hardware acceptance remains deferred'],
  ['TrayPort', 'Observe items and invoke current application actions/menus', 'StatusNotifier', 'Native session-bus watcher, owner retirement and DBusMenu revisions with SDK presentation. Owned protocol/client and native SNI/DBusMenu fixture checks pass; third-party application interoperability remains open'],
  ['MediaPort', 'Observe players and send captured-target controls', 'Mpris', 'Native MPRIS owner/property/seek signals, bounded commands and transient track handles'],
  ['WeatherPort', 'Return configured location weather', 'OpenMeteo', 'Checked requests, bounded legacy import and current/three-day decoding. Local/visual checks and scoped native opening/focus plus one production forecast pass; native form mutation and failure/retry remain open'],
  ['WallpaperPort', 'List, stage, commit and discard backgrounds', 'LucentWallpaper / WallpaperStore', 'Bounded immutable snapshots and atomic selection'],
  ['WallpaperPlaybackPort', 'Prepare owned media and supply timed decoded frames', 'NativeVideoWallpapers', 'Native FFmpeg libraries, validated RGBA frames, cancellation and FPS caps. The client owns output policy/latest delivery; the SDK owns reusable stream textures'],
  ['WallpaperCatalogPort', 'Search providers and download selected assets', 'OnlineWallpapers', 'Provider HTTP responses and local download cache'],
  ['PaletteGenerationPort', 'Derive a palette from an image', 'ImagePalette', 'Decoded pixel sampling and the design recipe'],
  ['ThemePort', 'Apply a validated palette', 'LucentTheme', 'Exports Lucent tokens to apps and session clients'],
  ['SessionPort', 'Request locking; observe lock state for background-work policy', 'LucentSession', 'Secure-lock wrapper plus bounded Hyprland observations; no authentication or unlock authority'],
  ['NotificationPort', 'Watch notifications and control their lifecycle', 'FreedesktopNotifications', 'D-Bus transport around pure notification policy'],
  ['NotificationHistoryPort', 'Load and save bounded private history', 'JsonNotificationHistory', 'Versioned durable history and DND; one ordered storage worker keeps filesystem work out of delivery and the UI thread'],
  ['AuthenticationPort', 'Run a trusted authentication conversation', 'PamLocker / Greetd', 'PAM or greetd; separate lock/login composition roots'],
  ['StopSignal', 'Cooperative cancellation and bounded waiting', 'WatchStop', 'Maps the framework cancellation handle into the domain contract'],
  ['AssetPort (presentation)', 'Supply decoded images and symbols for presentation targets', 'NativeAssets', 'Worker-side SVG/image loading and physical-size background mip retention; deliberately outside the pure domain'],
